# Backend API URLs
# Development build tries DEV_API_URL first (/health probe) and falls back to PROD_API_URL if unreachable.
# Production builds strictly use PROD_API_URL (or API_URL) and strip all dev endpoints/flags.
DEV_API_URL=http://localhost:3000
PROD_API_URL=https://raf-game.com

# Optional legacy fallback (used if PROD_API_URL / DEV_API_URL are not set)
# API_URL=https://raf-game.com
