{
  "name": "raf-launcher",
  "module": "index.tsx",
  "type": "module",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "dev": "bun index.tsx",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write --unsafe .",
    "lint": "bun run typecheck && bun run check",
    "test": "bun test",
    "prebuild": "bun run lint && bun run test",
    "precommit": "bun run lint",
    "build": "python3 build.py"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@gpuix/native-win32-x64-msvc": "^0.7.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.45.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@gpuix/native": "^0.7.0",
    "@gpuix/react": "^0.7.0",
    "msgpackr": "^2.1.0",
    "react": "19.0.0"
  },
  "overrides": {
    "react": "19.0.0"
  }
}
