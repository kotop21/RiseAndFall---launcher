{
  "name": "bungpuix-raf-launcher",
  "module": "index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun index.tsx",
    "dev:check": "bun index.tsx",
    "typecheck": "tsc --noEmit",
    "prebuild": "bun run typecheck",
    "build": "bun build index.tsx --outdir ./dist --target bun --minify",
    "start": "./dist/app",
  },
  "devDependencies": {
    "@gpuix/native-win32-x64-msvc": "^0.7.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.45.0"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@gpuix/native": "^0.7.0",
    "@gpuix/react": "^0.7.0",
    "msgpackr": "^2.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "sideEffects": false,
  "overrides": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
}
